# =============================================================================
# Bid Compliance Screening Service ? Environment Configuration Template
# Copy to .env for local development and docker compose
# =============================================================================

# Service & Logging
SERVICE_NAME=bidscreen-api
LOG_LEVEL=INFO
ENV=development

# Target Tender Identifier (Single Source of Truth)
TENDER_ID=GEM/2026/B/8034326

# Infrastructure Connections
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://bidscreen:bidscreen@localhost:5432/bidscreen
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Internal Service URLs
RETRIEVAL_URL=http://localhost:8002
LLM_STUB_URL=http://localhost:8003

# LLM Gateway Settings (OpenAI-compatible)
LLM_PROVIDER_URL=http://localhost:8003/v1
LLM_API_KEY=stub-key-do-not-commit
LLM_MODEL_NAME=stub-model
LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_TIMEOUT_S=20.0

# LLM Stub Chaos/Loadtest Flags
STUB_MODE=normal
STUB_DELAY_S=2.0
STUB_FAILURE_RATE=0.0

# Screening Engine & Agent Limits (§4.2)
TOOL_TIMEOUT_S=5.0
MAX_STEPS=12
MAX_TOOL_CALLS=15
RUN_TIMEOUT_S=60.0
MAX_VERIFY_RETRIES=2

# API Rate Limiter
RATE_LIMIT_PER_MINUTE=60

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
